{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/platform-app/Dockerfile"
  },
  "deploy": {
    "startCommand": "node serve.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "watchPatterns": [
    "apps/platform-app/**",
    "packages/shared/**",
    "packages/ui/**",
    "packages/tokens/**"
  ]
}
